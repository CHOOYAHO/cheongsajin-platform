rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.role == 'admin'; }
    function isMentor() { return signedIn() && request.auth.token.role == 'mentor'; }
    function isOwner(userId) { return signedIn() && request.auth.uid == userId; }
    function isAssignedMentor(studentId) {
      return isMentor()
        && studentId in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.assignedStudentIds;
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isAdmin();
    }

    match /programs/{programId} {
      allow read: if signedIn();
      allow write: if isAdmin();

      match /sessions/{sessionId} {
        allow read: if signedIn();
        allow write: if isAdmin();
      }
    }

    match /responses/{responseId} {
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow read: if isOwner(resource.data.userId) || isAssignedMentor(resource.data.userId) || isAdmin();
      allow update: if isOwner(resource.data.userId) || isAdmin();
      allow delete: if isAdmin();
    }

    match /feedback/{feedbackId} {
      allow read: if isOwner(resource.data.studentId) || isAssignedMentor(resource.data.studentId) || isAdmin();
      allow create: if (isMentor() && request.resource.data.mentorId == request.auth.uid) || isAdmin();
      allow update, delete: if isAdmin();
    }

    match /{document=**} { allow read, write: if false; }
  }
}
