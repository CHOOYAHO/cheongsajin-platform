rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.role == 'admin'; }
    function isMentor() { return signedIn() && request.auth.token.role == 'mentor'; }
    function isOwner(userId) { return signedIn() && request.auth.uid == userId; }
    function hasActiveStaffSession() {
      return signedIn()
        && exists(/databases/$(database)/documents/staffSessions/$(request.auth.uid))
        && get(/databases/$(database)/documents/staffSessions/$(request.auth.uid)).data.expiresAt > request.time;
    }
    function isAssignedMentor(studentId) {
      return isMentor()
        && studentId in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.assignedStudentIds;
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isAdmin();
    }

    match /programs/{programId} {
      allow read: if signedIn();
      allow write: if isAdmin();

      match /sessions/{sessionId} {
        allow read: if signedIn();
        allow write: if isAdmin();
      }
    }

    match /responses/{responseId} {
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow read: if isOwner(resource.data.userId) || isAssignedMentor(resource.data.userId) || isAdmin();
      allow update: if isOwner(resource.data.userId) || isAdmin();
      allow delete: if isAdmin();
    }

    match /feedback/{feedbackId} {
      allow read: if isOwner(resource.data.studentId) || isAssignedMentor(resource.data.studentId) || isAdmin();
      allow create: if (isMentor() && request.resource.data.mentorId == request.auth.uid) || isAdmin();
      allow update, delete: if isAdmin();
    }

    match /preferenceResults/{userId} {
      allow read: if isOwner(userId)
        || (hasActiveStaffSession()
          && (get(/databases/$(database)/documents/staffSessions/$(request.auth.uid)).data.role in ['mentor', 'admin']
            || (get(/databases/$(database)/documents/staffSessions/$(request.auth.uid)).data.role == 'teacher'
              && resource.data.schoolName == get(/databases/$(database)/documents/staffSessions/$(request.auth.uid)).data.schoolName)));
      allow create, update: if isOwner(userId)
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 30
        && request.resource.data.schoolName in ['예산고등학교', '광시중학교']
        && request.resource.data.coreLikes is list
        && request.resource.data.coreLikes.size() <= 3
        && request.resource.data.coreDislikes is list
        && request.resource.data.coreDislikes.size() <= 3
        && request.resource.data.reflection is string
        && request.resource.data.reflection.size() <= 400;
      allow delete: if false;
    }

    match /staffSessions/{userId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    match /studentSessions/{userId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    match /studentAccounts/{accountId} {
      allow read, write: if false;
    }

    match /system/{documentId} {
      allow read: if signedIn() && documentId == 'sessionLocks';
      allow write: if false;
    }

    match /studentProfiles/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && request.resource.data.userId == request.auth.uid;
      allow delete: if false;
    }

    match /auctionResults/{resultId} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid
        || (hasActiveStaffSession()
          && get(/databases/$(database)/documents/staffSessions/$(request.auth.uid)).data.role == 'admin'));
      allow write: if false;
    }

    match /mentorQuestions/{questionId} {
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.studentName is string
        && request.resource.data.studentName.size() > 0
        && request.resource.data.studentName.size() <= 30
        && request.resource.data.schoolName in ['예산고등학교', '광시중학교']
        && request.resource.data.mentorId is string
        && request.resource.data.mentorId.size() > 0
        && request.resource.data.question is string
        && request.resource.data.question.size() > 0
        && request.resource.data.question.size() <= 500
        && request.resource.data.status == 'waiting';
      allow read: if signedIn() && (resource.data.userId == request.auth.uid
        || (hasActiveStaffSession()
          && (get(/databases/$(database)/documents/staffSessions/$(request.auth.uid)).data.role == 'admin'
            || (get(/databases/$(database)/documents/staffSessions/$(request.auth.uid)).data.role == 'mentor'
              && get(/databases/$(database)/documents/staffSessions/$(request.auth.uid)).data.accountNumber == resource.data.mentorId))));
      allow update: if hasActiveStaffSession()
        && (get(/databases/$(database)/documents/staffSessions/$(request.auth.uid)).data.role == 'admin'
          || (get(/databases/$(database)/documents/staffSessions/$(request.auth.uid)).data.role == 'mentor'
            && get(/databases/$(database)/documents/staffSessions/$(request.auth.uid)).data.accountNumber == resource.data.mentorId))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'readAt', 'answer', 'answeredAt'])
        && request.resource.data.status in ['read', 'answered']
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['answer'])
          || (request.resource.data.answer is string
            && request.resource.data.answer.size() > 0
            && request.resource.data.answer.size() <= 1000));
      allow delete: if false;
    }

    match /aiInterviewLogs/{recordId} {
      allow read: if signedIn()
        && (resource.data.userId == request.auth.uid
          || (hasActiveStaffSession()
            && (get(/databases/$(database)/documents/staffSessions/$(request.auth.uid)).data.role in ['mentor', 'admin']
              || (get(/databases/$(database)/documents/staffSessions/$(request.auth.uid)).data.role == 'teacher'
                && resource.data.schoolName == get(/databases/$(database)/documents/staffSessions/$(request.auth.uid)).data.schoolName))));
      allow write: if false;
    }

    match /mentorProfiles/{accountNumber} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && exists(/databases/$(database)/documents/staffSessions/$(request.auth.uid))
        && get(/databases/$(database)/documents/staffSessions/$(request.auth.uid)).data.role in ['mentor', 'admin']
        && get(/databases/$(database)/documents/staffSessions/$(request.auth.uid)).data.accountNumber == accountNumber
        && get(/databases/$(database)/documents/staffSessions/$(request.auth.uid)).data.expiresAt > request.time
        && request.resource.data.accountNumber == accountNumber;
      allow delete: if false;
    }

    match /auctionRooms/{roomId} {
      allow create: if signedIn()
        && request.resource.data.hostId == request.auth.uid
        && request.resource.data.gameState == 'WAITING';
      allow read: if signedIn();
      allow update, delete: if false;

      match /votes/{userId} {
        allow read: if signedIn();
        allow write: if false;
      }

      match /participants/{userId} {
        allow read: if signedIn();
        allow create: if isOwner(userId)
          && request.resource.data.role in ['host', 'participant']
          && get(/databases/$(database)/documents/auctionRooms/$(roomId)).data.gameState == 'WAITING'
          && (request.resource.data.role == 'participant'
            || get(/databases/$(database)/documents/auctionRooms/$(roomId)).data.hostId == request.auth.uid)
          && request.resource.data.nickname is string
          && request.resource.data.nickname.size() > 0
          && request.resource.data.nickname.size() <= 12;
        allow update: if isOwner(userId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['connected', 'lastSeenAt']);
        allow delete: if isOwner(userId)
          || get(/databases/$(database)/documents/auctionRooms/$(roomId)).data.hostId == request.auth.uid;
      }
    }

    match /brainstormRooms/{roomId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.hostId == request.auth.uid
        && request.resource.data.gameState == 'WAITING'
        && request.resource.data.totalRounds is int
        && request.resource.data.totalRounds >= 1
        && request.resource.data.totalRounds <= 10
        && request.resource.data.timeLimit in [30, 60, 90, 120];
      allow update: if signedIn()
        && resource.data.hostId == request.auth.uid
        && request.resource.data.hostId == resource.data.hostId
        && request.resource.data.gameState in ['WAITING', 'COUNTDOWN', 'TASKS', 'STRENGTHS', 'ROUND_RESULT', 'RESULT', 'CLOSED']
        && request.resource.data.round is int
        && request.resource.data.round >= 1
        && request.resource.data.round <= request.resource.data.totalRounds
        && request.resource.data.totalRounds is int
        && request.resource.data.totalRounds >= 1
        && request.resource.data.totalRounds <= 10
        && request.resource.data.timeLimit in [30, 60, 90, 120]
        && request.resource.data.currentJob is string
        && request.resource.data.currentJob.size() <= 24;
      allow delete: if false;

      match /participants/{userId} {
        allow read: if signedIn();
        allow create: if isOwner(userId)
          && get(/databases/$(database)/documents/brainstormRooms/$(roomId)).data.gameState == 'WAITING'
          && request.resource.data.role in ['host', 'participant']
          && (request.resource.data.role == 'participant'
            || get(/databases/$(database)/documents/brainstormRooms/$(roomId)).data.hostId == request.auth.uid)
          && request.resource.data.nickname is string
          && request.resource.data.nickname.size() > 0
          && request.resource.data.nickname.size() <= 12;
        allow update: if isOwner(userId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['connected']);
        allow delete: if false;
      }

      match /submissions/{submissionId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.round is int
          && request.resource.data.round >= 1
          && request.resource.data.part in ['tasks', 'strengths']
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 240
          && request.resource.data.nickname is string
          && request.resource.data.nickname.size() > 0
          && request.resource.data.nickname.size() <= 12;
        allow update, delete: if false;
      }
    }

    match /{document=**} { allow read, write: if false; }
  }
}
